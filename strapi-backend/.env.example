# Server
HOST=0.0.0.0
PORT=1337

# Secrets — tạo giá trị thật bằng: node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
# (chạy 4 lần cho APP_KEYS, phân tách bằng dấu phẩy)
APP_KEYS=changeme1,changeme2,changeme3,changeme4
API_TOKEN_SALT=changeme
ADMIN_JWT_SECRET=changeme
JWT_SECRET=changeme
TRANSFER_TOKEN_SALT=changeme
ENCRYPTION_KEY=changeme

# Database — mặc định SQLite (dùng cho docker-compose.yml mặc định)
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Database — Postgres (chỉ cần khi bật profile "postgres" trong docker-compose.yml)
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=strapi
DATABASE_SSL=false
