# Server
# Chỉ bind loopback: nginx reverse-proxy tới 127.0.0.1:1337, không để Strapi
# lộ thẳng ra Internet ở cổng 1337. (Chạy trong Docker thì phải là 0.0.0.0.)
HOST=127.0.0.1
PORT=1337
# URL công khai mà nginx reverse-proxy trỏ tới (dùng để Strapi build đúng absolute
# URL cho admin panel, upload, email...). Đổi thành domain thật khi deploy.
PUBLIC_URL=https://cms.vbsf.vn
IS_PROXIED=true

# Secrets — tạo giá trị thật bằng: node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
# (chạy 4 lần cho APP_KEYS, phân tách bằng dấu phẩy)
APP_KEYS=changeme1,changeme2,changeme3,changeme4
API_TOKEN_SALT=changeme
ADMIN_JWT_SECRET=changeme
# Ký JWT đăng nhập hội viên/tổ chức trên site public (khác JWT của CMS)
PUBLIC_AUTH_JWT_SECRET=changeme
# Gốc URL site public — dùng dựng link đặt lại mật khẩu trong email
PUBLIC_SITE_URL=https://vbsf.vn
# Quên/đặt lại mật khẩu — TẮT cho tới khi có máy chủ email thật.
# Bật lại: đổi thành true VÀ đặt passwordReset:true trong site-js/config.js
PASSWORD_RESET_ENABLED=false
JWT_SECRET=changeme
TRANSFER_TOKEN_SALT=changeme
ENCRYPTION_KEY=changeme

# Database — production: Postgres cài thẳng trên host, nghe ở 127.0.0.1:5432.
# deploy/scripts/bootstrap-server.sh tự tạo role + database theo đúng
# DATABASE_NAME/USERNAME/PASSWORD dưới đây và sinh sẵn mật khẩu ngẫu nhiên.
# (Chạy local bằng docker-compose thì đổi DATABASE_HOST=postgres — tên service.)
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=vbsf_strapi
DATABASE_USERNAME=vbsf_strapi
DATABASE_PASSWORD=changeme
DATABASE_SSL=false

# SQLite — chỉ dùng khi DATABASE_CLIENT=sqlite (vd. chạy demo/local nhanh không cần Postgres)
DATABASE_FILENAME=.tmp/data.db

# Tạo tài khoản quản trị lần đầu (tùy chọn) — set 1 lần trên server rồi khởi động
# lại Strapi để bootstrap tự tạo (bỏ qua nếu email đã tồn tại). Sau khi đăng nhập
# được, nên xoá các dòng này khỏi .env trên server.
# BOOTSTRAP_ADMIN_EMAIL=admin@vbsf.vn
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_CMS_EMAIL=cms-admin@vbsf.vn
# BOOTSTRAP_CMS_PASSWORD=
