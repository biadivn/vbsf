    "club": { "type": "string" },
    "registeredAt": { "type": "datetime" },
    "feeStatus": {
      "type": "enumeration",
      "enum": ["unpaid", "paid"],
      "default": "unpaid"
    },
    "seed": { "type": "integer" },
    "rating": { "type": "integer" },
    "finalRank": { "type": "integer", "min": 1, "description": "Thứ hạng chung cuộc do vận hành nhập tay (hệ thống không ghi nhận kết quả thi đấu thực tế)" }
